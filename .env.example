# Copy this file to .env.local and add the keys you have. Never commit .env.local.
# With no keys the whole app runs on mock data.

# --- Critic and Strategist (OpenAI), and the Researcher's fallback ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Force every agent to its mock, even with keys set
# MOCK_AGENTS=true

# --- Researcher on Claude (used instead of OpenAI when this key is set) ---
# Also needed for the standalone /research page and `npm run researcher`
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# CLAUDE_MODEL=claude-sonnet-5-5
# How hard the agent works: low | medium | high | xhigh | max
# RESEARCH_EFFORT=high
# Most web searches the Researcher can run per request
# MAX_SEARCHES=20
# Set to true to remove web search (to demo the "tool fails" fallback)
# DISABLE_SEARCH=false
# MAX_TOKENS=32000
# Stream the agent's thinking summary in /research (true/false)
# SHOW_THINKING=true
# Where the standalone Researcher saves reports and visuals
# OUTPUT_DIR=output
